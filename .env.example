# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored — never commit real values.

# Safe to expose to the browser: anon access is constrained by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses row-level security entirely. Server-side ingestion only — must never
# be imported into client code or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
